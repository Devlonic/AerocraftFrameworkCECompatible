<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- defNames and class names are the original mod's, so work settings and saved jobs keep working. -->
  <WorkGiverDef>
    <defName>MYDE_AF_CE_ReloadTurrets</defName>
    <label>reload aircraft</label>
    <giverClass>MYDE_AerocraftFramework.WorkGiver_ReloadTurret</giverClass>
    <workType>Hauling</workType>
    <verb>reload</verb>
    <gerund>reloading</gerund>
    <priorityInType>106</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <nonColonistsCanDo>true</nonColonistsCanDo>
  </WorkGiverDef>
  <JobDef>
    <defName>MYDE_AF_CE_ReloadTurret</defName>
    <driverClass>MYDE_AerocraftFramework.JobDriver_ReloadTurret</driverClass>
    <reportString>reloading TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <modExtensions>
      <li Class="CombatExtended.JobDefExtensionCE">
        <isCrouchJob>true</isCrouchJob>
      </li>
    </modExtensions>
  </JobDef>
</Defs>
